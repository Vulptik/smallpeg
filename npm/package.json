{
  "name": "smallpeg",
  "version": "0.14.0",
  "description": "A dependency-free JPEG encoder, lossless optimizer and decoder, compiled to WebAssembly for Node and the browser.",
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/node.mjs",
  "types": "./dist/node.d.mts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      }
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "node",
    "web",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY.md"
  ],
  "keywords": [
    "jpeg",
    "jpg",
    "encoder",
    "compress",
    "optimize",
    "image",
    "wasm",
    "webassembly"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawapi/smallpeg.git",
    "directory": "npm"
  },
  "homepage": "https://sawapi.github.io/smallpeg/",
  "bugs": {
    "url": "https://github.com/sawapi/smallpeg/issues"
  },
  "author": "sawapi",
  "sideEffects": false,
  "scripts": {
    "prepack": "node -e \"for (const f of ['dist/core.mjs','dist/core.d.mts','dist/node.mjs','dist/node.d.mts','dist/web.mjs','dist/web.d.mts','node/smallpeg_wasm_bg.wasm','web/smallpeg_wasm_bg.wasm']) require('fs').accessSync(f)\" || (cd .. && ./npm/build.sh)",
    "test": "node test.mjs && tsc -p test-types.tsconfig.json && tsc -p test-types-node.tsconfig.json && tsc -p test-types-bundler.tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
